<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BetterShot.ico</ApplicationIcon>
    <AssemblyName>BetterShot</AssemblyName>
    <RootNamespace>BetterShot</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- MIT licensed (see ThirdPartyNotices/NAudio-LICENSE.txt): WASAPI microphone and system-audio (loopback) capture for screen recording. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\BetterShot.ico" />
    <Resource Include="Assets\Cursors\Grab.cur" />
    <Resource Include="Assets\Cursors\Grabbing.cur" />
    <Content Include="ThirdPartyNotices\Lucide-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices\NAudio-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices\Microsoft-Windows-SDK-NET-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
