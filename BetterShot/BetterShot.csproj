<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BetterShot.ico</ApplicationIcon>
    <AssemblyName>BetterShot</AssemblyName>
    <RootNamespace>BetterShot</RootNamespace>
    <OnnxRuntimeVersion>1.32.0</OnnxRuntimeVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\BetterShot.ico" />
    <Resource Include="Assets\Cursors\Grab.cur" />
    <Resource Include="Assets\Cursors\Grabbing.cur" />
    <Content Include="ThirdPartyNotices\Lucide-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices\OnnxRuntime-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices\U2Net-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- ONNX Runtime (MIT) runs the U2-Netp background-removal model locally. The model (Apache-2.0) is downloaded on first use, never bundled. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)" />
    <Content Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime/$(OnnxRuntimeVersion)/ThirdPartyNotices.txt" Link="ThirdPartyNotices\OnnxRuntime-ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" Condition="'$(NuGetPackageRoot)' != '' And Exists('$(NuGetPackageRoot)microsoft.ml.onnxruntime/$(OnnxRuntimeVersion)/ThirdPartyNotices.txt')" />
  </ItemGroup>
</Project>
