<Window x:Class="BetterShot.Ai.AskClaudeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BetterShot.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Ask about this capture" Width="720" Height="780" MinWidth="520" MinHeight="560"
    WindowStyle="None" ResizeMode="CanResize" Background="#151619" Foreground="{StaticResource TextBrush}"
    FontFamily="Segoe UI" FontSize="14" Icon="pack://application:,,,/Assets/BetterShot.ico" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="#24262A" />
      <Setter Property="BorderBrush" Value="#34363B" />
    </Style>
    <Style x:Key="PresetChip" TargetType="Button">
      <Setter Property="Foreground" Value="#E7E8EB" />
      <Setter Property="Background" Value="#202226" />
      <Setter Property="BorderBrush" Value="#3A3D44" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="#FFD84A" />
                <Setter TargetName="Chip" Property="Background" Value="#2A2818" />
                <Setter Property="Foreground" Value="#FFE477" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#FFFFFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chip" Property="Opacity" Value=".7" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SendButton" TargetType="Button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Foreground" Value="#17150B" />
      <Setter Property="Background" Value="#FFD84A" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="10" Padding="12">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FFE477" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".75" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuestionTextBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F0F1F3" />
      <Setter Property="Background" Value="#202226" />
      <Setter Property="BorderBrush" Value="#484B53" />
      <Setter Property="CaretBrush" Value="#FFD84A" />
      <Setter Property="SelectionBrush" Value="#8A7A2E" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,9">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#747984" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFD84A" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#36383E" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Background="#17181B" BorderBrush="#292B30" BorderThickness="0,0,0,1">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <controls:LucideIcon Icon="Sparkles" Width="17" Height="17" Foreground="#FFD84A" />
            <TextBlock Text="Ask about this capture" Margin="9,0,0,1" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
            <TextBlock x:Name="CaptureTitleText" Margin="10,0,0,1" VerticalAlignment="Center" FontSize="12" Foreground="#8F9299" TextTrimming="CharacterEllipsis" MaxWidth="320" />
          </StackPanel>
          <Button Style="{StaticResource ChromeButton}" HorizontalAlignment="Right" ToolTip="Close" AutomationProperties.Name="Close" Click="Close_Click">
            <controls:LucideIcon Icon="X" Width="13" Height="13" Foreground="#C8C9CD" />
          </Button>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="22,18,22,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="PreviewFrame" Background="#0C0D10" BorderBrush="#303238" BorderThickness="1" CornerRadius="10" Padding="4" Height="170">
          <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <TextBlock x:Name="IntroText" Grid.Row="1" Margin="2,14,0,10" Foreground="#A5A7AD" FontSize="13" TextWrapping="Wrap"
                   Text="Claude reads the capture and answers about it. Pick a question below or write your own." />
        <WrapPanel x:Name="PresetPanel" Grid.Row="2" Margin="0,0,0,6" />
        <Border Grid.Row="3" Background="#191B1F" BorderBrush="#303238" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0" MinHeight="140">
          <Grid>
            <RichTextBox x:Name="AnswerView" IsReadOnly="True" IsReadOnlyCaretVisible="False" Background="Transparent" BorderThickness="0" Padding="12,10"
                         Foreground="#E7E8EB" SelectionBrush="#8A7A2E" FontFamily="Segoe UI" FontSize="14"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Conversation" />
            <TextBlock x:Name="EmptyAnswerText" Text="Answers appear here." Foreground="#6F727A" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
        </Border>
        <Border x:Name="ErrorBanner" Grid.Row="4" Visibility="Collapsed" Margin="0,10,0,0" Background="#2E1E20" BorderBrush="#6B3A3E" BorderThickness="1" CornerRadius="8" Padding="12,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Foreground="#FFB4B4" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Name="OpenSettingsButton" Grid.Column="1" Style="{StaticResource QuietButton}" Height="30" Margin="10,0,0,0" Content="Open Settings" Click="OpenSettings_Click" Visibility="Collapsed" />
          </Grid>
        </Border>
        <Grid Grid.Row="5" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="QuestionBox" Style="{StaticResource QuestionTextBox}" MinHeight="44" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" PreviewKeyDown="QuestionBox_PreviewKeyDown" TextChanged="QuestionBox_TextChanged" AutomationProperties.Name="Question" />
          <TextBlock x:Name="QuestionPlaceholder" Text="What would you like to know?" Foreground="#73767E" FontSize="14" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource SendButton}" Margin="10,0,0,0" VerticalAlignment="Bottom" Click="Send_Click" ToolTip="Send (Enter). Shift+Enter adds a new line." AutomationProperties.Name="Send">
            <controls:LucideIcon x:Name="SendIcon" Icon="Send" Width="18" Height="18" Foreground="#17150B" />
          </Button>
        </Grid>
        <Grid Grid.Row="6" Margin="0,12,0,0">
          <TextBlock x:Name="StatusText" Foreground="#8F9299" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,300,0" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="NewConversationButton" Style="{StaticResource QuietButton}" Click="NewConversation_Click" ToolTip="Clear the answers and start over with this capture">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Icon="MessageSquarePlus" Width="15" Height="15" Margin="0,0,7,0" />
                <TextBlock Text="New conversation" />
              </StackPanel>
            </Button>
            <Button x:Name="CopyAnswerButton" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="CopyAnswer_Click" ToolTip="Copy the latest answer as text">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon x:Name="CopyIcon" Icon="Copy" Width="15" Height="15" Margin="0,0,7,0" />
                <TextBlock x:Name="CopyAnswerText" Text="Copy answer" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
