<UserControl x:Class="BetterShot.Presentation.RecordingSetupCard" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BetterShot.Controls"
             Width="356" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#F4F4F5"
             UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal">
  <UserControl.Resources>
    <SolidColorBrush x:Key="SubtleText" Color="#A1A1AA" />
    <SolidColorBrush x:Key="TileBackground" Color="#26262A" />
    <SolidColorBrush x:Key="TileHover" Color="#2E2E33" />
    <SolidColorBrush x:Key="TileBorder" Color="#38383E" />
    <SolidColorBrush x:Key="FocusRing" Color="#FFD60A" />

    <Style x:Key="Tile" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource TileBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource TileBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="12,0,10,0" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <Style x:Key="RowIcon" TargetType="controls:LucideIcon">
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="19" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#D4D4D8" />
    </Style>

    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Pill switch: yellow track with a dark knob when on, gray track with a light knob when off. -->
    <Style x:Key="PillSwitch" TargetType="ToggleButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Width="38" Height="23" Background="Transparent">
              <Border x:Name="Ring" Margin="-3" CornerRadius="14" BorderBrush="{StaticResource FocusRing}" BorderThickness="2" Visibility="Collapsed" />
              <Border x:Name="Track" CornerRadius="11.5" Background="#46464C" />
              <Ellipse x:Name="Knob" Width="17" Height="17" Margin="3,0" HorizontalAlignment="Left" Fill="#D9D9DE" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#FFD60A" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Fill" Value="#1C1C1E" />
                <Setter TargetName="Ring" Property="BorderBrush" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Countdown segments: Off | 3 s | 5 s. -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="#E4E4E7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chrome" MinWidth="38" Height="28" Padding="10,0" CornerRadius="14" Background="Transparent" BorderBrush="#404046" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#303035" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#3D3D43" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#5A5A61" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource FocusRing}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Device name with a chevron; opens the device menu. -->
    <Style x:Key="DeviceLink" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{StaticResource SubtleText}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,1" Padding="0,0,0,1">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" MaxWidth="200" VerticalAlignment="Center" />
                <controls:LucideIcon Icon="ChevronDown" Width="12" Height="12" Margin="4,1,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#E4E4E7" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource FocusRing}" />
                <Setter Property="Foreground" Value="#E4E4E7" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The Area tile is one button: clicking it picks the area again. -->
    <Style x:Key="AreaTile" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="#F4F4F5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{StaticResource TileBackground}" BorderBrush="{StaticResource TileBorder}" BorderThickness="1" CornerRadius="11" Padding="12,0,10,0" MinHeight="50">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource TileHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource FocusRing}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="#D4D4D8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Width="32" Height="32" CornerRadius="16" Background="#1F1F23" BorderBrush="#3A3A40" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#2E2E33" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource FocusRing}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StartButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="#1A1112" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Ring" Margin="-3" CornerRadius="15" BorderBrush="#FFFFFF" BorderThickness="2" Visibility="Collapsed" />
              <Border x:Name="Chrome" Height="44" CornerRadius="12" Background="#EC716A">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#F2827B" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#D9615B" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border CornerRadius="18" Background="#F41B1B1E" BorderBrush="#3A3A40" BorderThickness="1" Padding="16,14,16,16">
    <StackPanel>
      <Grid Margin="2,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="10" Height="10" Fill="#F2665F" VerticalAlignment="Center" Margin="0,1,10,0" />
        <TextBlock Grid.Column="1" Text="New recording" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource CloseButton}" Click="CloseButton_Click"
                ToolTip="Cancel (Esc)" AutomationProperties.Name="Cancel recording">
          <controls:LucideIcon Icon="X" Width="15" Height="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
      </Grid>

      <Button x:Name="AreaButton" Style="{StaticResource AreaTile}" Margin="0,0,0,12" Click="AreaButton_Click"
              ToolTip="Pick a different area" AutomationProperties.Name="Area. Pick a different area">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:LucideIcon x:Name="AreaIcon" Icon="SquareDashed" Style="{StaticResource RowIcon}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,6">
            <TextBlock x:Name="AreaTitleText" Text="Area" Style="{StaticResource RowTitle}" />
            <TextBlock x:Name="AreaDetailText" Text="0 × 0" FontSize="12.5" Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Button>

      <Border x:Name="MicrophoneTile" Style="{StaticResource Tile}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:LucideIcon x:Name="MicrophoneIcon" Icon="Mic" Style="{StaticResource RowIcon}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,6">
            <TextBlock Text="Microphone" Style="{StaticResource RowTitle}" />
            <Button x:Name="MicrophoneDeviceButton" Style="{StaticResource DeviceLink}" Content="Default microphone" Click="MicrophoneDevice_Click"
                    ToolTip="Select microphone" AutomationProperties.Name="Select microphone" />
          </StackPanel>
          <ToggleButton x:Name="MicrophoneToggle" Grid.Column="2" Style="{StaticResource PillSwitch}" Click="Toggle_Click"
                        ToolTip="Record microphone" AutomationProperties.Name="Record microphone" />
        </Grid>
      </Border>

      <Border x:Name="CameraTile" Style="{StaticResource Tile}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:LucideIcon x:Name="CameraIcon" Icon="CameraOff" Style="{StaticResource RowIcon}" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,6">
            <TextBlock Text="Camera" Style="{StaticResource RowTitle}" />
            <Button x:Name="CameraDeviceButton" Style="{StaticResource DeviceLink}" Content="Default camera" Click="CameraDevice_Click"
                    ToolTip="Select camera" AutomationProperties.Name="Select camera" />
          </StackPanel>
          <ToggleButton x:Name="CameraToggle" Grid.Column="2" Style="{StaticResource PillSwitch}" Click="Toggle_Click"
                        ToolTip="Record camera" AutomationProperties.Name="Record camera" />
        </Grid>
      </Border>

      <Border x:Name="SystemAudioTile" Style="{StaticResource Tile}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:LucideIcon Icon="Volume2" Style="{StaticResource RowIcon}" />
          <TextBlock Grid.Column="1" Text="System audio" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
          <ToggleButton x:Name="SystemAudioToggle" Grid.Column="2" Style="{StaticResource PillSwitch}" Click="Toggle_Click"
                        ToolTip="Record system audio" AutomationProperties.Name="Record system audio" />
        </Grid>
      </Border>

      <Border x:Name="ClicksTile" Style="{StaticResource Tile}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:LucideIcon Icon="MousePointerClick" Style="{StaticResource RowIcon}" />
          <TextBlock Grid.Column="1" Text="Show clicks" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
          <ToggleButton x:Name="ClicksToggle" Grid.Column="2" Style="{StaticResource PillSwitch}" Click="Toggle_Click"
                        ToolTip="Show clicks" AutomationProperties.Name="Show clicks" />
        </Grid>
      </Border>

      <Border x:Name="KeystrokesTile" Style="{StaticResource Tile}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:LucideIcon Icon="Keyboard" Style="{StaticResource RowIcon}" />
          <TextBlock Grid.Column="1" Text="Show keystrokes" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
          <ToggleButton x:Name="KeystrokesToggle" Grid.Column="2" Style="{StaticResource PillSwitch}" Click="Toggle_Click"
                        ToolTip="Show keyboard shortcuts" AutomationProperties.Name="Show keystrokes" />
        </Grid>
      </Border>

      <Border Style="{StaticResource Tile}" Margin="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:LucideIcon Icon="Timer" Style="{StaticResource RowIcon}" />
          <TextBlock Grid.Column="1" Text="Countdown" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="Countdown">
            <RadioButton x:Name="CountdownOff" GroupName="RecordingSetupCountdown" Style="{StaticResource Segment}" Content="Off" Tag="0" Checked="Countdown_Checked" Margin="0" AutomationProperties.Name="No countdown" />
            <RadioButton x:Name="CountdownThree" GroupName="RecordingSetupCountdown" Style="{StaticResource Segment}" Content="3 s" Tag="3" Checked="Countdown_Checked" AutomationProperties.Name="3 second countdown" />
            <RadioButton x:Name="CountdownFive" GroupName="RecordingSetupCountdown" Style="{StaticResource Segment}" Content="5 s" Tag="5" Checked="Countdown_Checked" AutomationProperties.Name="5 second countdown" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock x:Name="SaveFolderText" Margin="2,14,0,10" FontSize="12.5" Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis" Text="Saves to ~" />

      <Button x:Name="StartButton" Style="{StaticResource StartButton}" Click="StartButton_Click"
              ToolTip="Start recording (Enter)" AutomationProperties.Name="Start recording">
        <StackPanel Orientation="Horizontal">
          <controls:LucideIcon Icon="CircleDot" Width="17" Height="17" Margin="0,1,8,0" VerticalAlignment="Center" Foreground="#1A1112" />
          <TextBlock Text="Start recording" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
