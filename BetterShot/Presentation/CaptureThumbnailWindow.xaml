<Window x:Class="BetterShot.Presentation.CaptureThumbnailWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BetterShot.Controls"
 Width="332" Height="242" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True">
 <Window.Resources><Style x:Key="IconButton" TargetType="Button"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#ECEDE8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3B3D45"/><Setter Property="Foreground" Value="#FFD84A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value=".65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
 <Border x:Name="Card" Margin="8" Background="#F21B1C21" BorderBrush="#4B4D55" BorderThickness="1" CornerRadius="13" Padding="7" Cursor="Hand" ToolTip="Click to edit; drag to share the rendered image (Settings can drag it as a PNG file)" PreviewMouseLeftButtonDown="Card_MouseLeftButtonDown" PreviewMouseMove="Card_MouseMove" PreviewMouseLeftButtonUp="Card_MouseLeftButtonUp" LostMouseCapture="Card_LostMouseCapture"><Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity=".52" Color="#000000"/></Border.Effect><Grid>
  <Border CornerRadius="9" ClipToBounds="True" Background="#0C0D10"><Image x:Name="ThumbnailImage" Stretch="Uniform" ToolTip="Click to edit; drag to share the rendered image (Settings can drag it as a PNG file)"/></Border>
  <Border x:Name="ActionTray" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9" Background="#F2282A30" BorderBrush="#4C4E56" BorderThickness="1" CornerRadius="10" Padding="3" Opacity="0"><Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity=".55"/></Border.Effect><StackPanel Orientation="Horizontal">
   <Button Style="{StaticResource IconButton}" Click="Edit_Click" ToolTip="Edit capture"><controls:LucideIcon Icon="Pencil" Width="18" Height="18" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
   <Button Style="{StaticResource IconButton}" Click="Copy_Click" ToolTip="Copy rendered image"><controls:LucideIcon Icon="Copy" Width="18" Height="18" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
   <Button Style="{StaticResource IconButton}" Click="Save_Click" ToolTip="Save rendered image as PNG"><controls:LucideIcon Icon="Save" Width="18" Height="18" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>

   <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Click="Delete_Click" ToolTip="Delete capture permanently"><controls:LucideIcon Icon="Trash2" Width="18" Height="18" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
  </StackPanel></Border>
  <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="28" Height="28" Padding="6" Margin="6" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#F2282A30" Click="Dismiss_Click" ToolTip="Dismiss thumbnail (capture remains in Recent)" AutomationProperties.Name="Dismiss thumbnail"><controls:LucideIcon Icon="X" Width="16" Height="16" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
 </Grid></Border>
</Window>
