<Window x:Class="BetterShot.MainWindow" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BetterShot.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="BetterShot" Width="1100" Height="900" MinWidth="780" MinHeight="700" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#151619" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14" Icon="Assets/BetterShot.ico" PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="#24262A" />
      <Setter Property="BorderBrush" Value="#34363B" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Width" Value="88" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style x:Key="RecentCard" TargetType="ListBoxItem">
      <Setter Property="ToolTip" Value="{Binding Details}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Details}" />
      <Setter Property="Width" Value="{Binding RecentCardWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E7E8EB" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#383B42" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#4A4323" />
                <Setter Property="Foreground" Value="#FFE477" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkComboBox" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F0F1F3" />
      <Setter Property="Background" Value="#24262A" />
      <Setter Property="BorderBrush" Value="#484B53" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,0,38,0" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SelectorBorder" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="7">
                      <Grid>
                        <ContentPresenter Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                        <Path Data="M 0 0 L 5 5 L 10 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectorBorder" Property="BorderBrush" Value="#747984" /></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectorBorder" Property="BorderBrush" Value="#FFD84A" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#202226" BorderBrush="#50535B" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,4,0,0">
                  <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#FFD84A" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SearchTextBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F0F1F3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CaretBrush" Value="#FFD84A" />
      <Setter Property="SelectionBrush" Value="#8A7A2E" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SearchFrame" TargetType="Border">
      <Setter Property="Background" Value="#24262A" />
      <Setter Property="BorderBrush" Value="#484B53" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#747984" /></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#FFD84A" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ShortcutToggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="ToggleTrack" Width="32" Height="18" CornerRadius="9" Background="#373A41" BorderBrush="#555961" BorderThickness="1" VerticalAlignment="Center">
                <Ellipse x:Name="ToggleKnob" Width="12" Height="12" Fill="#CFD1D6" HorizontalAlignment="Left" Margin="2,0" />
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleTrack" Property="Background" Value="#FFD84A" />
                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#FFD84A" />
                <Setter TargetName="ToggleKnob" Property="Fill" Value="#17150B" />
                <Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="White" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
      <RowDefinition Height="40" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#17181B" BorderBrush="#292B30" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Image Source="Assets/BetterShot.ico" Width="16" Height="16" />
          <TextBlock Text="BetterShot" Margin="8,0,0,1" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="SettingsButton" Style="{StaticResource ChromeButton}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click">
            <controls:LucideIcon Icon="Settings" Width="16" Height="16" Foreground="#C8C9CD" />
          </Button>
          <Button Style="{StaticResource ChromeButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Minimize_Click">
            <controls:LucideIcon Icon="Minus" Width="12" Height="12" Foreground="#C8C9CD" />
          </Button>
          <Button Style="{StaticResource ChromeButton}" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore" Click="Maximize_Click">
            <controls:LucideIcon Icon="Square" Width="12" Height="12" Foreground="#C8C9CD" />
          </Button>
          <Button Style="{StaticResource ChromeButton}" ToolTip="Close to tray" AutomationProperties.Name="Close to tray" Click="Close_Click">
            <controls:LucideIcon Icon="X" Width="12" Height="12" Foreground="#C8C9CD" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="36,18,36,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="AreaButton" Width="190" Height="40" Background="#FFD84A" Foreground="#17150B" BorderBrush="#FFD84A" Click="Area_Click" ToolTip="Select a region (Ctrl + Shift + F9)">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Icon="Maximize" Width="16" Height="16" Margin="0,0,8,0" Foreground="#17150B" />
            <TextBlock Text="Capture area" Foreground="#17150B" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
          <Button x:Name="WindowButton" Style="{StaticResource QuietButton}" Height="40" MinWidth="112" Padding="14,6" FontSize="14" Click="Window_Click" ToolTip="Click a window to capture it">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Icon="AppWindow" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock x:Name="WindowButtonText" Text="Window" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="DisplayButton" Style="{StaticResource QuietButton}" Height="40" MinWidth="112" Padding="14,6" FontSize="14" Margin="10,0,0,0" Click="Display_Click" ToolTip="Click a display to capture it">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Icon="Monitor" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock x:Name="DisplayButtonText" Text="Display" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="FullscreenButton" Style="{StaticResource QuietButton}" Height="40" MinWidth="112" Padding="14,6" FontSize="14" Margin="10,0,0,0" Click="Fullscreen_Click" ToolTip="Capture the whole display under the pointer immediately">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Icon="Fullscreen" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock x:Name="FullscreenButtonText" Text="Fullscreen" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock x:Name="CaptureShortcutText" Grid.Column="3" Text="Ctrl + Shift + F9" Foreground="#8F9299" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
      <Border Grid.Row="1" Margin="0,14,0,0" Background="Transparent" CornerRadius="12" BorderBrush="Transparent" BorderThickness="0">
        <Grid>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
            <Border Width="70" Height="70" CornerRadius="35" Background="#242318" BorderBrush="#464021" BorderThickness="1" Margin="0,0,0,18">
              <controls:LucideIcon Icon="PanelBottom" Width="29" Height="29" Foreground="#FFD84A" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Ready for your next capture" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Capture an area, window, or display. Your screenshot will stay close by as a thumbnail until you need it." Foreground="#9B9DA5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,0" />
          </StackPanel>
          <Grid x:Name="RecentState" Visibility="Collapsed" Margin="0,4,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <TextBlock x:Name="CaptureHeading" Text="Latest capture" Foreground="#F0F1F3" FontSize="18" FontWeight="SemiBold" />
              <TextBlock x:Name="SelectedTimeText" HorizontalAlignment="Right" Foreground="#A0A2A9" FontSize="14" />
            </Grid>
            <Border Grid.Row="1" MinHeight="160" Margin="0,12,0,12" Background="#191B1F" CornerRadius="10" BorderBrush="#303238" BorderThickness="1" Padding="4">
              <Image x:Name="PreviewImage" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp" ToolTip="Open this capture in the editor" />
            </Border>
            <Grid Grid.Row="2" Margin="0,0,0,14">
              <TextBlock x:Name="SelectedMetaText" Foreground="#A0A2A9" FontSize="14" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ActionButton}" Click="OpenRecent_Click">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Icon="Pencil" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="Edit" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Click="CopyRecent_Click">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Icon="Copy" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="Copy" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Width="112" Click="CopyRecentText_Click" ToolTip="Copy the text in this capture (read on this PC)">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Icon="ScanText" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="Copy text" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Click="SaveRecent_Click">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Icon="Save" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="Save" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="3">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Recent captures" Foreground="#F0F1F3" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Grid.Column="1" Style="{StaticResource SearchFrame}" Width="260" Height="32" HorizontalAlignment="Right" Margin="16,0,14,0" Cursor="IBeam">
                  <Grid>
                    <controls:LucideIcon Icon="Search" Width="14" Height="14" Foreground="#9B9DA5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchPlaceholder" Text="Search names and text" Foreground="#7F828A" FontSize="13" Margin="32,0,30,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}" Margin="30,0,30,0" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="Search by time, date, typed markup, and text inside images" AutomationProperties.Name="Search names and text" />
                    <Button x:Name="ClearSearchButton" HorizontalAlignment="Right" VerticalAlignment="Center" Width="24" Height="24" Margin="0,0,4,0" Padding="5" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="ClearSearch_Click" ToolTip="Clear search" AutomationProperties.Name="Clear search">
                      <controls:LucideIcon Icon="X" Width="12" Height="12" />
                    </Button>
                  </Grid>
                </Border>
                <TextBlock Grid.Column="2" Text="Stored locally" VerticalAlignment="Center" Foreground="#92959C" FontSize="13" />
              </Grid>
              <ListBox x:Name="RecentList" ItemsSource="{Binding}" SelectionChanged="RecentList_SelectionChanged" PreviewKeyDown="RecentList_PreviewKeyDown" Background="Transparent" BorderThickness="0" Grid.Row="1" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" ItemContainerStyle="{StaticResource RecentCard}">
                <ListBox.Resources>
                  <Style TargetType="ScrollBar">
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Margin" Value="0,8,0,0" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                          <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                              <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False">
                                  <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                      <Border Background="Transparent" />
                                    </ControlTemplate>
                                  </RepeatButton.Template>
                                </RepeatButton>
                              </Track.DecreaseRepeatButton>
                              <Track.Thumb>
                                <Thumb>
                                  <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                      <Border x:Name="Grip" Background="#383B42" CornerRadius="4" Margin="0,2" />
                                      <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                          <Setter TargetName="Grip" Property="Background" Value="#646873" />
                                        </Trigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </Thumb.Template>
                                </Thumb>
                              </Track.Thumb>
                              <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False">
                                  <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                      <Border Background="Transparent" />
                                    </ControlTemplate>
                                  </RepeatButton.Template>
                                </RepeatButton>
                              </Track.IncreaseRepeatButton>
                            </Track>
                          </Grid>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.Resources>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding RecentImageHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Border x:Name="ThumbnailFrame" Background="#191B1F" CornerRadius="7" BorderBrush="#34363B" BorderThickness="1" Padding="3" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                      </Border>
                      <Button x:Name="DeleteRecentButton" Tag="{Binding Document}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34" Margin="6" Padding="8" Background="#E6282A30" BorderBrush="#555861" BorderThickness="1" Visibility="Hidden" ToolTip="Delete capture permanently" AutomationProperties.Name="Delete capture permanently" Click="DeleteRecent_Click">
                        <controls:LucideIcon Icon="Trash2" Width="17" Height="17" />
                      </Button>
                      <TextBlock Grid.Row="1" Text="{Binding ShortLabel}" Foreground="#B4B6BC" FontSize="14" Margin="3,8,3,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="ThumbnailFrame" Property="BorderBrush" Value="#747984" />
                        <Setter TargetName="DeleteRecentButton" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="ThumbnailFrame" Property="BorderBrush" Value="#D7DADF" />
                        <Setter TargetName="DeleteRecentButton" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="ThumbnailFrame" Property="BorderBrush" Value="#FFD84A" />
                        <Setter TargetName="ThumbnailFrame" Property="BorderThickness" Value="2" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="SearchEmptyText" Grid.Row="1" Visibility="Collapsed" Foreground="#9B9DA5" FontSize="13" TextWrapping="Wrap" Margin="2,10,2,10" VerticalAlignment="Top" />
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#151619" BorderBrush="#292B30" BorderThickness="0,1,0,0" Padding="36,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <controls:LucideIcon Icon="PanelBottom" Foreground="#90939A" Width="17" Height="17" Margin="0,0,10,0" />
          <TextBlock Text="Available in your tray" Foreground="#90939A" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="StatusText" Text="" Foreground="#A5A7AD" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="590" />
      </Grid>
    </Border>
    <Border x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" Width="430" HorizontalAlignment="Right" Background="#1B1C20" BorderBrush="#36383E" BorderThickness="1,0,0,0" Padding="30" Panel.ZIndex="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <ScrollViewer.Resources>
          <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4B4E57" CornerRadius="4" Margin="1,0" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                  </Track>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ScrollViewer.Resources>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
          <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#D7D8DB" />
          </Style>
          <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9B9EA5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
          </Style>
          <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E7E8EB" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <Style x:Key="SettingToggle" TargetType="CheckBox" BasedOn="{StaticResource ShortcutToggle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,12,0,0" />
          </Style>
          <Style x:Key="RecorderButton" TargetType="controls:HotkeyRecorderButton" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,5,0,5" />
          </Style>
          <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F0F1F3" />
            <Setter Property="Background" Value="#24262A" />
            <Setter Property="BorderBrush" Value="#484B53" />
            <Setter Property="CaretBrush" Value="#FFD84A" />
            <Setter Property="SelectionBrush" Value="#8A7A2E" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                  <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,0">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#747984" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFD84A" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Slider">
                  <Grid Height="22" Background="Transparent">
                    <Border Height="4" CornerRadius="2" Background="#373A41" VerticalAlignment="Center" />
                    <Track x:Name="PART_Track">
                      <Track.DecreaseRepeatButton>
                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                          <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="#FFD84A" VerticalAlignment="Center" /></ControlTemplate></RepeatButton.Template>
                        </RepeatButton>
                      </Track.DecreaseRepeatButton>
                      <Track.IncreaseRepeatButton>
                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                          <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                        </RepeatButton>
                      </Track.IncreaseRepeatButton>
                      <Track.Thumb>
                        <Thumb>
                          <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse x:Name="Knob" Width="16" Height="16" Fill="#FFD84A" Stroke="#17150B" StrokeThickness="1" /></ControlTemplate></Thumb.Template>
                        </Thumb>
                      </Track.Thumb>
                    </Track>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Grid.Resources>
        <Grid>
          <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
          <Button HorizontalAlignment="Right" Width="34" Height="34" Padding="8" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Close settings" Click="SettingsClose_Click">
            <controls:LucideIcon Icon="X" Width="16" Height="16" />
          </Button>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,28,0,0">
          <TextBlock Text="Startup" Style="{StaticResource SectionHeader}" />
          <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource ShortcutToggle}" Content="Start with Windows" Foreground="{StaticResource TextBrush}" Margin="0,14,0,0" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed" />
          <TextBlock Text="Open quietly in the tray when you sign in." Foreground="#9B9EA5" FontSize="12" TextWrapping="Wrap" Margin="24,8,0,24" />

          <TextBlock Text="Capture" Style="{StaticResource SectionHeader}" />
          <CheckBox Style="{StaticResource ShortcutToggle}" x:Name="ReplaceShortcutCheckBox" Content="Use Win + Shift + S for area capture" Foreground="{StaticResource TextBrush}" Margin="0,16,0,0" Checked="ReplaceShortcut_Changed" Unchecked="ReplaceShortcut_Changed" />
          <TextBlock Text="Remembered across restarts. Ctrl + Shift + F9 always captures an area." Style="{StaticResource SettingHint}" Margin="24,8,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Area" Style="{StaticResource SettingLabel}" />
            <controls:HotkeyRecorderButton x:Name="AreaHotkeyRecorder" Grid.Column="1" Style="{StaticResource RecorderButton}" Tag="Area" AutomationProperties.Name="Area capture shortcut" RecordingStarted="HotkeyRecorder_RecordingStarted" RecordingEnded="HotkeyRecorder_RecordingEnded" Recorded="HotkeyRecorder_Recorded" />
            <TextBlock Grid.Row="1" Text="Window" Style="{StaticResource SettingLabel}" />
            <controls:HotkeyRecorderButton x:Name="WindowHotkeyRecorder" Grid.Row="1" Grid.Column="1" Style="{StaticResource RecorderButton}" Tag="Window" AutomationProperties.Name="Window capture shortcut" RecordingStarted="HotkeyRecorder_RecordingStarted" RecordingEnded="HotkeyRecorder_RecordingEnded" Recorded="HotkeyRecorder_Recorded" />
            <TextBlock Grid.Row="2" Text="Fullscreen (display under pointer)" Style="{StaticResource SettingLabel}" TextTrimming="CharacterEllipsis" />
            <controls:HotkeyRecorderButton x:Name="FullscreenHotkeyRecorder" Grid.Row="2" Grid.Column="1" Style="{StaticResource RecorderButton}" Tag="Fullscreen" AutomationProperties.Name="Fullscreen capture shortcut" RecordingStarted="HotkeyRecorder_RecordingStarted" RecordingEnded="HotkeyRecorder_RecordingEnded" Recorded="HotkeyRecorder_Recorded" />
            <TextBlock Grid.Row="3" Text="Open library" Style="{StaticResource SettingLabel}" />
            <controls:HotkeyRecorderButton x:Name="LibraryHotkeyRecorder" Grid.Row="3" Grid.Column="1" Style="{StaticResource RecorderButton}" Tag="Library" AutomationProperties.Name="Open library shortcut" RecordingStarted="HotkeyRecorder_RecordingStarted" RecordingEnded="HotkeyRecorder_RecordingEnded" Recorded="HotkeyRecorder_Recorded" />
          </Grid>
          <TextBlock Text="Click a shortcut, then press the keys. Esc cancels; Backspace clears." Style="{StaticResource SettingHint}" Margin="0,6,0,0" />
          <TextBlock x:Name="HotkeyProblemText" Style="{StaticResource SettingHint}" Foreground="#FF8787" Margin="0,6,0,0" Visibility="Collapsed" />
          <Grid Margin="0,14,0,0">
            <TextBlock Text="Delay before capture" Style="{StaticResource SettingLabel}" />
            <ComboBox x:Name="DelayComboBox" Style="{StaticResource DarkComboBox}" Width="130" Height="34" HorizontalAlignment="Right" SelectionChanged="DelayCombo_SelectionChanged" AutomationProperties.Name="Delay before capture">
              <ComboBoxItem Content="Off" Tag="0" />
              <ComboBoxItem Content="3 seconds" Tag="3" />
              <ComboBoxItem Content="5 seconds" Tag="5" />
              <ComboBoxItem Content="10 seconds" Tag="10" />
            </ComboBox>
          </Grid>
          <TextBlock Text="Gives you time to open menus. A countdown appears at the bottom of the screen; use the shortcut again to cancel." Style="{StaticResource SettingHint}" Margin="0,8,0,24" />

          <TextBlock Text="After capture" Style="{StaticResource SectionHeader}" />
          <CheckBox x:Name="CopyToClipboardCheckBox" Style="{StaticResource SettingToggle}" Content="Copy to clipboard" Checked="AfterCaptureToggle_Changed" Unchecked="AfterCaptureToggle_Changed" />
          <CheckBox x:Name="ShowThumbnailCheckBox" Style="{StaticResource SettingToggle}" Content="Show floating thumbnail" Checked="AfterCaptureToggle_Changed" Unchecked="AfterCaptureToggle_Changed" />
          <TextBlock Text="When off, each capture is saved straight to the save folder." Style="{StaticResource SettingHint}" Margin="24,6,0,0" />
          <CheckBox x:Name="OpenEditorCheckBox" Style="{StaticResource SettingToggle}" Content="Open editor after capture" Checked="AfterCaptureToggle_Changed" Unchecked="AfterCaptureToggle_Changed" />
          <CheckBox x:Name="PlaySoundCheckBox" Style="{StaticResource SettingToggle}" Content="Play capture sound" Checked="AfterCaptureToggle_Changed" Unchecked="AfterCaptureToggle_Changed" />
          <Grid Margin="0,16,0,0">
            <TextBlock Text="Auto-dismiss thumbnails" Style="{StaticResource SettingLabel}" />
            <ComboBox x:Name="AutoDismissComboBox" Style="{StaticResource DarkComboBox}" Width="130" Height="34" HorizontalAlignment="Right" SelectionChanged="AutoDismissCombo_SelectionChanged" AutomationProperties.Name="Auto-dismiss thumbnails">
              <ComboBoxItem Content="Never" Tag="0" />
              <ComboBoxItem Content="10 seconds" Tag="10" />
              <ComboBoxItem Content="30 seconds" Tag="30" />
              <ComboBoxItem Content="60 seconds" Tag="60" />
            </ComboBox>
          </Grid>
          <TextBlock Text="Hovering a thumbnail pauses the countdown. Dismissed captures stay in the library." Style="{StaticResource SettingHint}" Margin="0,8,0,24" />

          <TextBlock Text="Saving" Style="{StaticResource SectionHeader}" />
          <TextBlock Text="Save folder" Style="{StaticResource SettingLabel}" Margin="0,14,0,0" />
          <Border Background="#121316" BorderBrush="#34363B" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,8,0,0">
            <TextBlock x:Name="SaveFolderText" Foreground="#C9CBD0" FontSize="12" TextTrimming="CharacterEllipsis" />
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="ChooseSaveFolderButton" Style="{StaticResource QuietButton}" Click="ChooseSaveFolder_Click" ToolTip="Choose where captures are saved">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Icon="Folder" Width="15" Height="15" Margin="0,0,7,0" />
                <TextBlock Text="Choose…" />
              </StackPanel>
            </Button>
            <Button x:Name="OpenSaveFolderButton" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="OpenSaveFolder_Click" ToolTip="Open the save folder in File Explorer">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Icon="FolderOpen" Width="15" Height="15" Margin="0,0,7,0" />
                <TextBlock Text="Open save folder" />
              </StackPanel>
            </Button>
          </StackPanel>
          <CheckBox x:Name="AutoSaveCheckBox" Style="{StaticResource SettingToggle}" Content="Save every capture to this folder" Margin="0,14,0,0" Checked="AfterCaptureToggle_Changed" Unchecked="AfterCaptureToggle_Changed" />
          <TextBlock Text="File name" Style="{StaticResource SettingLabel}" Margin="0,16,0,0" />
          <TextBox x:Name="FileNamePatternBox" Style="{StaticResource DarkTextBox}" Height="34" Margin="0,8,0,0" TextChanged="FileNamePattern_TextChanged" LostKeyboardFocus="FileNamePattern_LostKeyboardFocus" KeyDown="FileNamePattern_KeyDown" AutomationProperties.Name="File name pattern" />
          <TextBlock x:Name="FileNamePreviewText" Foreground="#FFE477" FontSize="12" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="Tokens: %date (2026-08-05), %time (10.22.31), %year, %month, %day, %hour, %minute, %second, %counter. Characters Windows doesn't allow become dashes; existing files get (2), (3)…" Style="{StaticResource SettingHint}" Margin="0,6,0,0" />
          <Grid Margin="0,16,0,0">
            <TextBlock Text="Format" Style="{StaticResource SettingLabel}" />
            <ComboBox x:Name="FormatComboBox" Style="{StaticResource DarkComboBox}" Width="130" Height="34" HorizontalAlignment="Right" SelectionChanged="FormatCombo_SelectionChanged" AutomationProperties.Name="Image format">
              <ComboBoxItem Content="PNG" Tag="png" />
              <ComboBoxItem Content="JPEG" Tag="jpeg" />
            </ComboBox>
          </Grid>
          <Grid x:Name="JpegQualityRow" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="JPEG quality" Style="{StaticResource SettingLabel}" />
            <Slider x:Name="JpegQualitySlider" Grid.Column="1" Style="{StaticResource DarkSlider}" Minimum="10" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" Margin="14,0,10,0" VerticalAlignment="Center" ValueChanged="JpegQuality_ValueChanged" LostMouseCapture="JpegQuality_Commit" LostKeyboardFocus="JpegQuality_Commit" AutomationProperties.Name="JPEG quality" />
            <TextBlock x:Name="JpegQualityText" Grid.Column="2" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right" />
          </Grid>
          <Grid Margin="0,14,0,0">
            <TextBlock Text="Export size" Style="{StaticResource SettingLabel}" />
            <ComboBox x:Name="ResizeComboBox" Style="{StaticResource DarkComboBox}" Width="190" Height="34" HorizontalAlignment="Right" SelectionChanged="ResizeCombo_SelectionChanged" AutomationProperties.Name="Export size">
              <ComboBoxItem Content="Full size" Tag="0" />
              <ComboBoxItem Content="Fit within 1920 px" Tag="1920" />
              <ComboBoxItem Content="Fit within 1280 px" Tag="1280" />
            </ComboBox>
          </Grid>
          <CheckBox x:Name="ResizeClipboardCheckBox" Style="{StaticResource SettingToggle}" Content="Also resize clipboard copies" Checked="AfterCaptureToggle_Changed" Unchecked="AfterCaptureToggle_Changed" />
          <TextBlock Text="Format and size apply to saved files and dragged images. Clipboard copies stay full size unless the option above is on; the library always keeps the original." Style="{StaticResource SettingHint}" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,30,0,0">
          <TextBlock Text="Library" Style="{StaticResource SectionHeader}" />
          <TextBlock Text="Automatically delete captures from the library after this long. Saved copies are kept." Foreground="#9B9EA5" FontSize="13" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,10" />
          <ComboBox x:Name="RetentionComboBox" Style="{StaticResource DarkComboBox}" Width="160" Height="38" HorizontalAlignment="Left" SelectionChanged="RetentionCombo_SelectionChanged">
            <ComboBoxItem Content="1 day" Tag="1" />
            <ComboBoxItem Content="7 days" Tag="7" />
            <ComboBoxItem Content="14 days" Tag="14" />
            <ComboBoxItem Content="30 days" Tag="30" />
            <ComboBoxItem Content="90 days" Tag="90" />
            <ComboBoxItem Content="180 days" Tag="180" />
            <ComboBoxItem Content="Never" Tag="0" />
          </ComboBox>
          <CheckBox x:Name="SearchTextCheckBox" Style="{StaticResource SettingToggle}" Content="Search text inside images" Margin="0,18,0,0" Checked="SearchText_Changed" Unchecked="SearchText_Changed" />
          <TextBlock Text="Reads the words in your captures on this PC with Windows text recognition so library search can find them. Images are never uploaded. Turning this off deletes the stored text." Style="{StaticResource SettingHint}" Margin="24,6,0,0" />
          <TextBlock x:Name="TextIndexStatusText" Style="{StaticResource SettingHint}" Foreground="#C9CBD0" Margin="24,6,0,0" />
          <TextBlock Text="Keep markup editable" Style="{StaticResource SettingLabel}" FontWeight="SemiBold" Margin="0,18,0,0" />
          <TextBlock Text="Arrows, shapes, text, and other markup stay editable for as long as a capture is in the library. Open it again to move, restyle, or delete anything. Redactions are always burned into copied, saved, and dragged images." Style="{StaticResource SettingHint}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,30,0,0">
          <TextBlock Text="Drag screenshots" FontSize="16" FontWeight="SemiBold" Foreground="#D7D8DB" />
          <ComboBox x:Name="DragModeComboBox" Style="{StaticResource DarkComboBox}" Width="220" Height="38" HorizontalAlignment="Left" Margin="0,12,0,0" SelectionChanged="DragMode_SelectionChanged">
            <ComboBoxItem Content="Image (compatible)" Tag="image" />
            <ComboBoxItem Content="PNG file" Tag="file" />
          </ComboBox>
          <TextBlock Text="Image mode includes a PNG attachment for Slack and other upload targets. PNG file mode offers only a file." Foreground="#9B9EA5" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,26" />
          <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Foreground="#D7D8DB" />
          <TextBlock x:Name="VersionText" Margin="0,12,0,0" Foreground="#A6A8AE" />
          <Button Style="{StaticResource QuietButton}" Content="Open-source licenses" HorizontalAlignment="Left" Margin="0,13,0,0" Click="Licenses_Click" />
        </StackPanel>
        <Border x:Name="LicensePanel" Grid.Row="4" MaxHeight="220" Visibility="Collapsed" Background="#121316" BorderBrush="#34363B" BorderThickness="1" CornerRadius="8" Margin="0,18,0,0" Padding="11">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="LicenseText" FontFamily="Consolas" FontSize="12" Foreground="#B9BBC0" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>