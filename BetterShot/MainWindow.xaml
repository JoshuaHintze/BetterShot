<Window x:Class="BetterShot.MainWindow" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BetterShot.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="BetterShot" Width="1100" Height="900" MinWidth="780" MinHeight="700" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#151619" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14" Icon="Assets/BetterShot.ico" PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="#24262A" />
      <Setter Property="BorderBrush" Value="#34363B" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Width" Value="88" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style x:Key="RecentCard" TargetType="ListBoxItem">
      <Setter Property="ToolTip" Value="{Binding Details}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Details}" />
      <Setter Property="Width" Value="{Binding RecentCardWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E7E8EB" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#383B42" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#4A4323" />
                <Setter Property="Foreground" Value="#FFE477" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkComboBox" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#F0F1F3" />
      <Setter Property="Background" Value="#24262A" />
      <Setter Property="BorderBrush" Value="#484B53" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,0,38,0" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SelectorBorder" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="7">
                      <Grid>
                        <ContentPresenter Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                        <Path Data="M 0 0 L 5 5 L 10 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectorBorder" Property="BorderBrush" Value="#747984" /></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectorBorder" Property="BorderBrush" Value="#FFD84A" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#202226" BorderBrush="#50535B" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,4,0,0">
                  <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#FFD84A" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ShortcutToggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="ToggleTrack" Width="32" Height="18" CornerRadius="9" Background="#373A41" BorderBrush="#555961" BorderThickness="1" VerticalAlignment="Center">
                <Ellipse x:Name="ToggleKnob" Width="12" Height="12" Fill="#CFD1D6" HorizontalAlignment="Left" Margin="2,0" />
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleTrack" Property="Background" Value="#FFD84A" />
                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="#FFD84A" />
                <Setter TargetName="ToggleKnob" Property="Fill" Value="#17150B" />
                <Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="White" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
      <RowDefinition Height="40" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#17181B" BorderBrush="#292B30" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Image Source="Assets/BetterShot.ico" Width="16" Height="16" />
          <TextBlock Text="BetterShot" Margin="8,0,0,1" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="SettingsButton" Style="{StaticResource ChromeButton}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click">
            <controls:LucideIcon Icon="Settings" Width="16" Height="16" Foreground="#C8C9CD" />
          </Button>
          <Button Style="{StaticResource ChromeButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Minimize_Click">
            <controls:LucideIcon Icon="Minus" Width="12" Height="12" Foreground="#C8C9CD" />
          </Button>
          <Button Style="{StaticResource ChromeButton}" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore" Click="Maximize_Click">
            <controls:LucideIcon Icon="Square" Width="12" Height="12" Foreground="#C8C9CD" />
          </Button>
          <Button Style="{StaticResource ChromeButton}" ToolTip="Close to tray" AutomationProperties.Name="Close to tray" Click="Close_Click">
            <controls:LucideIcon Icon="X" Width="12" Height="12" Foreground="#C8C9CD" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="36,18,36,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="AreaButton" Width="190" Height="40" Background="#FFD84A" Foreground="#17150B" BorderBrush="#FFD84A" Click="Area_Click" ToolTip="Select a region (Ctrl + Shift + F9)">
          <StackPanel Orientation="Horizontal">
            <controls:LucideIcon Icon="Maximize" Width="16" Height="16" Margin="0,0,8,0" Foreground="#17150B" />
            <TextBlock Text="Capture area" Foreground="#17150B" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
          <Button x:Name="WindowButton" Style="{StaticResource QuietButton}" Height="40" Width="160" FontSize="14" Click="Window_Click">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Icon="AppWindow" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock x:Name="WindowButtonText" Text="Capture window" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="DisplayButton" Style="{StaticResource QuietButton}" Height="40" Width="160" FontSize="14" Margin="10,0,0,0" Click="Display_Click">
            <StackPanel Orientation="Horizontal">
              <controls:LucideIcon Icon="Monitor" Width="16" Height="16" Margin="0,0,8,0" />
              <TextBlock x:Name="DisplayButtonText" Text="Capture display" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock x:Name="CaptureShortcutText" Grid.Column="3" Text="Ctrl + Shift + F9" Foreground="#8F9299" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" />
      </Grid>
      <Border Grid.Row="1" Margin="0,14,0,0" Background="Transparent" CornerRadius="12" BorderBrush="Transparent" BorderThickness="0">
        <Grid>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
            <Border Width="70" Height="70" CornerRadius="35" Background="#242318" BorderBrush="#464021" BorderThickness="1" Margin="0,0,0,18">
              <controls:LucideIcon Icon="PanelBottom" Width="29" Height="29" Foreground="#FFD84A" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Ready for your next capture" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Capture an area, window, or display. Your screenshot will stay close by as a thumbnail until you need it." Foreground="#9B9DA5" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,0" />
          </StackPanel>
          <Grid x:Name="RecentState" Visibility="Collapsed" Margin="0,4,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <TextBlock x:Name="CaptureHeading" Text="Latest capture" Foreground="#F0F1F3" FontSize="18" FontWeight="SemiBold" />
              <TextBlock x:Name="SelectedTimeText" HorizontalAlignment="Right" Foreground="#A0A2A9" FontSize="14" />
            </Grid>
            <Border Grid.Row="1" MinHeight="160" Margin="0,12,0,12" Background="#191B1F" CornerRadius="10" BorderBrush="#303238" BorderThickness="1" Padding="4">
              <Image x:Name="PreviewImage" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp" ToolTip="Open this capture in the editor" />
            </Border>
            <Grid Grid.Row="2" Margin="0,0,0,14">
              <TextBlock x:Name="SelectedMetaText" Foreground="#A0A2A9" FontSize="14" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ActionButton}" Click="OpenRecent_Click">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Icon="Pencil" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="Edit" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Click="CopyRecent_Click">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Icon="Copy" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="Copy" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource ActionButton}" Click="SaveRecent_Click">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Icon="Save" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="Save" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="3">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="Recent captures" Foreground="#F0F1F3" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Stored locally" HorizontalAlignment="Right" Foreground="#92959C" FontSize="13" />
              </Grid>
              <ListBox x:Name="RecentList" ItemsSource="{Binding}" SelectionChanged="RecentList_SelectionChanged" PreviewKeyDown="RecentList_PreviewKeyDown" Background="Transparent" BorderThickness="0" Grid.Row="1" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" ItemContainerStyle="{StaticResource RecentCard}">
                <ListBox.Resources>
                  <Style TargetType="ScrollBar">
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Margin" Value="0,8,0,0" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                          <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                              <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False">
                                  <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                      <Border Background="Transparent" />
                                    </ControlTemplate>
                                  </RepeatButton.Template>
                                </RepeatButton>
                              </Track.DecreaseRepeatButton>
                              <Track.Thumb>
                                <Thumb>
                                  <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                      <Border x:Name="Grip" Background="#383B42" CornerRadius="4" Margin="0,2" />
                                      <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                          <Setter TargetName="Grip" Property="Background" Value="#646873" />
                                        </Trigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </Thumb.Template>
                                </Thumb>
                              </Track.Thumb>
                              <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False">
                                  <RepeatButton.Template>
                                    <ControlTemplate TargetType="RepeatButton">
                                      <Border Background="Transparent" />
                                    </ControlTemplate>
                                  </RepeatButton.Template>
                                </RepeatButton>
                              </Track.IncreaseRepeatButton>
                            </Track>
                          </Grid>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.Resources>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="{Binding RecentImageHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Border x:Name="ThumbnailFrame" Background="#191B1F" CornerRadius="7" BorderBrush="#34363B" BorderThickness="1" Padding="3" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                      </Border>
                      <Button x:Name="DeleteRecentButton" Tag="{Binding Document}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34" Margin="6" Padding="8" Background="#E6282A30" BorderBrush="#555861" BorderThickness="1" Visibility="Hidden" ToolTip="Delete capture permanently" AutomationProperties.Name="Delete capture permanently" Click="DeleteRecent_Click">
                        <controls:LucideIcon Icon="Trash2" Width="17" Height="17" />
                      </Button>
                      <TextBlock Grid.Row="1" Text="{Binding ShortLabel}" Foreground="#B4B6BC" FontSize="14" Margin="3,8,3,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="ThumbnailFrame" Property="BorderBrush" Value="#747984" />
                        <Setter TargetName="DeleteRecentButton" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="ThumbnailFrame" Property="BorderBrush" Value="#D7DADF" />
                        <Setter TargetName="DeleteRecentButton" Property="Visibility" Value="Visible" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="ThumbnailFrame" Property="BorderBrush" Value="#FFD84A" />
                        <Setter TargetName="ThumbnailFrame" Property="BorderThickness" Value="2" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#151619" BorderBrush="#292B30" BorderThickness="0,1,0,0" Padding="36,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <controls:LucideIcon Icon="PanelBottom" Foreground="#90939A" Width="17" Height="17" Margin="0,0,10,0" />
          <TextBlock Text="Available in your tray" Foreground="#90939A" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="StatusText" Text="" Foreground="#A5A7AD" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="590" />
      </Grid>
    </Border>
    <Border x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" Width="430" HorizontalAlignment="Right" Background="#1B1C20" BorderBrush="#36383E" BorderThickness="1,0,0,0" Padding="30" Panel.ZIndex="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <ScrollViewer.Resources>
          <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4B4E57" CornerRadius="4" Margin="1,0" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                  </Track>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ScrollViewer.Resources>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
          <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
          <Button HorizontalAlignment="Right" Width="34" Height="34" Padding="8" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Close settings" Click="SettingsClose_Click">
            <controls:LucideIcon Icon="X" Width="16" Height="16" />
          </Button>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,28,0,0">
          <TextBlock Text="Startup" FontSize="16" FontWeight="SemiBold" Foreground="#D7D8DB" />
          <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource ShortcutToggle}" Content="Start with Windows" Foreground="{StaticResource TextBrush}" Margin="0,14,0,0" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed" />
          <TextBlock Text="Open quietly in the tray when you sign in." Foreground="#9B9EA5" FontSize="12" TextWrapping="Wrap" Margin="24,8,0,24" />
          <TextBlock Text="Capture shortcuts" FontSize="16" FontWeight="SemiBold" Foreground="#D7D8DB" />
          <CheckBox Style="{StaticResource ShortcutToggle}" x:Name="ReplaceShortcutCheckBox" Content="Use Win + Shift + S for BetterShot" Foreground="{StaticResource TextBrush}" Margin="0,16,0,0" Checked="ReplaceShortcut_Changed" Unchecked="ReplaceShortcut_Changed" />
          <TextBlock Text="Remembered across restarts. Fallback: Ctrl + Shift + F9" Foreground="#9B9EA5" FontSize="12" TextWrapping="Wrap" Margin="24,8,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,30,0,0">
          <TextBlock Text="Capture history" FontSize="16" FontWeight="SemiBold" Foreground="#D7D8DB" />
          <TextBlock Text="Automatically delete captures after this many days. Saved copies are kept." Foreground="#9B9EA5" FontSize="13" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,10" />
          <ComboBox x:Name="RetentionComboBox" Style="{StaticResource DarkComboBox}" Width="160" Height="38" HorizontalAlignment="Left" SelectionChanged="RetentionCombo_SelectionChanged">
            <ComboBoxItem Content="1 day" Tag="1" />
            <ComboBoxItem Content="7 days" Tag="7" />
            <ComboBoxItem Content="14 days" Tag="14" />
            <ComboBoxItem Content="30 days" Tag="30" />
            <ComboBoxItem Content="90 days" Tag="90" />
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,30,0,0">
          <TextBlock Text="Drag screenshots" FontSize="16" FontWeight="SemiBold" Foreground="#D7D8DB" />
          <ComboBox x:Name="DragModeComboBox" Style="{StaticResource DarkComboBox}" Width="220" Height="38" HorizontalAlignment="Left" Margin="0,12,0,0" SelectionChanged="DragMode_SelectionChanged">
            <ComboBoxItem Content="Image (compatible)" Tag="image" />
            <ComboBoxItem Content="PNG file" Tag="file" />
          </ComboBox>
          <TextBlock Text="Image mode includes a PNG attachment for Slack and other upload targets. PNG file mode offers only a file." Foreground="#9B9EA5" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,26" />
          <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Foreground="#D7D8DB" />
          <TextBlock x:Name="VersionText" Margin="0,12,0,0" Foreground="#A6A8AE" />
          <Button Style="{StaticResource QuietButton}" Content="Open-source licenses" HorizontalAlignment="Left" Margin="0,13,0,0" Click="Licenses_Click" />
        </StackPanel>
        <Border x:Name="LicensePanel" Grid.Row="4" MaxHeight="220" Visibility="Collapsed" Background="#121316" BorderBrush="#34363B" BorderThickness="1" CornerRadius="8" Margin="0,18,0,0" Padding="11">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="LicenseText" FontFamily="Consolas" FontSize="12" Foreground="#B9BBC0" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>